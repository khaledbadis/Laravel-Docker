# Local development only. Copy to .env; never use this password in production.
COMPOSE_PROJECT_NAME=laravel-todo
LOCAL_UID=1000
LOCAL_GID=1000
WEB_PORT=8080
VITE_PORT=5173

APP_NAME="Laravel Docker Todo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=todo
DB_USERNAME=todo
DB_PASSWORD=local-development-only

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=debug
