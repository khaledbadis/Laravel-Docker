# Copy to .env.production in a dedicated release directory. Keep it private (chmod 600).
COMPOSE_PROJECT_NAME=little-list-prod
IMAGE_REPOSITORY=ghcr.io/your-account/your-repository
# deploy.sh supplies RELEASE_SHA; manual Compose commands must export it too.
APP_URL=https://todo.example.com
APP_KEY=
DB_DATABASE=todo
DB_USERNAME=todo
DB_PASSWORD=
WEB_PORT=8081
AUTH_REGISTRATION_ENABLED=false
# Exact address/CIDR of the TLS edge as seen by PHP's REMOTE_ADDR.
# For a host edge proxy this is normally the Docker bridge gateway; inspect it.
# Never use * on an ingress reachable by untrusted clients.
TRUSTED_PROXIES=
